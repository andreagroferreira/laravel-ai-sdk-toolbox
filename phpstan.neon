includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:

    paths:
        - src
        - tests

    excludePaths:
        # Pest's $this HTTP helpers (getJson/postJson) are not analyzable;
        # the files are covered by runtime feature tests.
        - tests/Feature/HttpApiTest.php
        - tests/Feature/HttpPluginsTest.php
        - tests/Feature/HttpKnowledgeTest.php
        - tests/Feature/SkillUpdateTest.php
        - tests/Feature/Knowledge/QdrantStoreTest.php
        - tests/Unit/Knowledge/QdrantStoreTest.php

    level: max

    tmpDir: /tmp/phpstan
