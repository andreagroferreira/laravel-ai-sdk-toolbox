{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "andreagroferreira/laravel-ai-sdk-toolbox",
    "description": "The Laravel AI SDK on steroids — Claude-compatible skills, plugins and knowledge bases for your agents.",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "skills",
        "laravel-ai-sdk",
        "andreagroferreira"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4.0",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/process": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/ai": "^0.10",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.29.1",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "AndreAgroFerreira\\AiSdkToolbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndreAgroFerreira\\AiSdkToolbox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:lint": "pint --test",
        "test:types": "phpstan",
        "test:unit": "pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndreAgroFerreira\\AiSdkToolbox\\AiSdkToolboxServiceProvider"
            ],
            "aliases": {
                "AiSdkToolbox": "AndreAgroFerreira\\AiSdkToolbox\\Facades\\AiSdkToolbox"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
